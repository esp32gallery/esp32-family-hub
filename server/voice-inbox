function saveIndex(list) {
  fs.writeFileSync(INDEX_PATH, JSON.stringify(list, null, 1));
}

// ---------------------------------------------------------------- WAV 解析
function parseWav(buf) {
  if (buf.length < 44) return { ok: false, reason: "不足 44 字节" };
  if (buf.toString("ascii", 0, 4) !== "RIFF") return { ok: false, reason: "不是 RIFF" };
  if (buf.toString("ascii", 8, 12) !== "WAVE") return { ok: false, reason: "不是 WAVE" };
  let p = 12, fmt = null, data = null;
  while (p + 8 <= buf.length) {
    const id = buf.toString("ascii", p, p + 4);
    const sz = buf.readUInt32LE(p + 4);
    const body = p + 8;
    if (id === "fmt " && body + 16 <= buf.length) {
      fmt = {
        audioFormat: buf.readUInt16LE(body),
        channels: buf.readUInt16LE(body + 2),
        sampleRate: buf.readUInt32LE(body + 4),
        bits: buf.readUInt16LE(body + 14),
      };
    } else if (id === "data") {
      data = { len: Math.min(sz, buf.length - body) };
    }
    p = body + sz + (sz & 1);
  }
  if (!fmt) return { ok: false, reason: "没有 fmt" };
  if (!data) return { ok: false, reason: "没有 data" };
  if (fmt.audioFormat !== 1) return { ok: false, reason: `不是 PCM(${fmt.audioFormat})` };
  if (data.len < 800) return { ok: false, reason: `太短(${data.len}B)` };
  const bps = fmt.sampleRate * fmt.channels * (fmt.bits / 8);
  return {
    ok: true, sampleRate: fmt.sampleRate, channels: fmt.channels, bits: fmt.bits,
    seconds: data.len / bps, dataLen: data.len,
  };
}

// ffmpeg may add LIST/metadata chunks. The board streams the canonical 44-byte
// PCM layout, so repack converted uploads to that exact layout.
function canonicalWav(buf, sampleRate = 32000) {
  let p = 12, data = null;
  while (p + 8 <= buf.length) {
    const size = buf.readUInt32LE(p + 4);
    if (buf.toString("ascii", p, p + 4) === "data") {
      data = buf.subarray(p + 8, Math.min(p + 8 + size, buf.length)); break;
    }
    p += 8 + size + (size & 1);
  }
  if (!data || !data.length) throw new Error("missing PCM data");
  const head = Buffer.alloc(44);
  head.write("RIFF", 0); head.writeUInt32LE(data.length + 36, 4);
  head.write("WAVEfmt ", 8); head.writeUInt32LE(16, 16);
  head.writeUInt16LE(1, 20); head.writeUInt16LE(1, 22);
  head.writeUInt32LE(sampleRate, 24); head.writeUInt32LE(sampleRate * 2, 28);
  head.writeUInt16LE(2, 32); head.writeUInt16LE(16, 34);
  head.write("data", 36); head.writeUInt32LE(data.length, 40);
  return Buffer.concat([head, data]);
}

// ---------------------------------------------------------------- 推送
/** 发推送。失败只记日志，绝不影响「语音已保存」这件事。 */
async function pushNotify(contactKey, meta, id) {
  const c = loadConf();
  const who = c.contacts?.[contactKey];
  if (!who) { log(`推送跳过：没有联系人 ${contactKey}`); return { ok: false, why: "no contact" }; }
  const p = who.push || {};
  const link = `${baseUrl()}/#${id}`;
  const title = `${who.name} 给你留了语音`;
  const body = `${meta.seconds.toFixed(1)} 秒 · 点开收听`;

  try {
    if (p.type === "bark") {
      // Bark: GET <base>/<title>/<body>?url=...&group=...
      const base = p.url.replace(/\/+$/, "");
      const u = `${base}/${encodeURIComponent(title)}/${encodeURIComponent(body)}`
        + `?url=${encodeURIComponent(link)}&group=voice&level=timeSensitive`;
      const r = await fetch(u, { signal: AbortSignal.timeout(10000) });
      const j = await r.json().catch(() => ({}));
      log(`推送 bark ${who.name}: ${r.status} ${j.code ?? ""}`);
      return { ok: r.ok && j.code === 200, status: r.status };
    }

    if (p.type === "ntfy") {
      // ntfy: POST <server>/<topic>
      const u = `${p.server || "https://ntfy.sh"}/${p.topic}`;
      const r = await fetch(u, {
        method: "POST",
        headers: { Title: title, Click: link, Tags: "speech_balloon", Priority: "high" },
        body: body,
        signal: AbortSignal.timeout(10000),
      });
      log(`推送 ntfy ${who.name}: ${r.status}`);
      return { ok: r.ok, status: r.status };
    }

    if (p.type === "webhook") {
      const r = await fetch(p.url, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ title, body, link, contact: contactKey, id, seconds: meta.seconds }),
        signal: AbortSignal.timeout(10000),
      });
      log(`推送 webhook ${who.name}: ${r.status}`);
      return { ok: r.ok, status: r.status };
    }

    log(`推送跳过：未知通道 ${p.type}`);
    return { ok: false, why: "unknown type" };
  } catch (e) {
    log(`推送失败（${who.name}）：${e.message}`);
    return { ok: false, why: e.message };
  }
}

