<script>
let items = [], contacts = {}, filter = null, playing = null;
const BASE = location.pathname.startsWith('/voice/') ? '/voice' : '';

function fmtTime(ts) {
  const d = new Date(ts), now = new Date();
  const hm = d.toTimeString().slice(0,5);
  if (d.toDateString() === now.toDateString()) return '今天 ' + hm;
  return (d.getMonth()+1) + '月' + d.getDate() + '日 ' + hm;
}
function fmtSize(b) { return b > 1048576 ? (b/1048576).toFixed(1)+'MB' : Math.round(b/1024)+'KB'; }

function renderTabs() {
  const el = document.getElementById('tabs');
  const keys = Object.keys(contacts);
  el.innerHTML = ['<div class="tab' + (filter===null?' on':'') + '" data-f="">全部</div>']
    .concat(keys.map(k => '<div class="tab' + (filter===k?' on':'') + '" data-f="'+k+'">' + contacts[k] + '</div>'))
    .join('');
}

function render() {
  const el = document.getElementById('list');
  const list = filter ? items.filter(it => it.contact === filter) : items;
  if (!list.length) {
    el.innerHTML = '<div class="empty">还没有语音<br>在板子上选联系人、按住屏幕说话</div>';
    return;
  }
  el.innerHTML = list.map(it => \`
    <div class="item \${it.direction === 'in' ? 'in' : 'out'}" id="i-\${it.id}">
      <button class="play" data-play="\${it.id}">▶</button>
      <div class="meta">
        <div class="from">\${it.direction === 'in' ? (contacts[it.contact] || it.contact || '家人') : '宝宝'}</div>
        <div class="time">\${fmtTime(it.ts)}</div>
        <div class="info">\${it.seconds.toFixed(1)}s · \${it.sampleRate}Hz · \${fmtSize(it.bytes)}</div>
        <div class="bar"><i id="bar-\${it.id}"></i></div>
      </div>
      <button class="del" data-del="\${it.id}">✕</button>
    </div>\`).join('');
}

async function refresh() {
  try {
    const r = await fetch(BASE + '/api/list', { cache:'no-store' });
    const j = await r.json();
    items = j.items; contacts = j.contacts || {};
    document.getElementById('dot').className = 'dot';
    document.getElementById('stat').textContent = items.length + ' 条';
    renderTabs(); render();
    items.slice(0, 3).forEach(it => warmAudio(it.id));
  } catch (e) {
    document.getElementById('dot').className = 'dot off';
    document.getElementById('stat').textContent = '离线';
  }
}

let audio = new Audio();
audio.preload = 'auto';
audio.playsInline = true;
const audioCache = new Map();
function warmAudio(id) {
  if (!id || audioCache.has(id)) return;
  const el = new Audio(BASE + '/audio/' + id);
  el.preload = 'auto'; el.playsInline = true;
  el.load(); audioCache.set(id, el);
  while (audioCache.size > 8) audioCache.delete(audioCache.keys().next().value);
}
audio.addEventListener('ended', stopPlay);
audio.addEventListener('playing', () => {
  if (!playing) return;
  const b = document.querySelector('[data-play="'+playing+'"]');
  if (b) b.textContent='❚❚';
});
audio.addEventListener('timeupdate', () => {
  if (!playing) return;
  const bar = document.getElementById('bar-' + playing);
  if (bar && audio.duration) bar.style.width = (audio.currentTime/audio.duration*100) + '%';
});
function stopPlay() {
  if (playing) {
    const b = document.querySelector('[data-play="'+playing+'"]');
    if (b) { b.textContent='▶'; b.classList.remove('playing'); }
    const bar = document.getElementById('bar-'+playing);
    if (bar) bar.style.width='0';
  }
  playing = null;
}

document.addEventListener('click', async (e) => {
  const f = e.target.dataset.f;
  if (f !== undefined) { filter = f || null; renderTabs(); render(); return; }

  const playId = e.target.dataset.play;
  if (playId) {
    if (playing === playId) { audio.pause(); stopPlay(); return; }
    stopPlay(); playing = playId;
    const btn = document.querySelector('[data-play="'+playId+'"]');
    btn.textContent='…'; btn.classList.add('playing');
    audio.src = BASE + '/audio/' + playId;
    audio.play().catch(() => {
      stopPlay();
      document.getElementById('stat').textContent = '请再点一次播放';
    });
    return;
  }

  const delId = e.target.dataset.del;
  if (delId) {
    if (!confirm('删除这条语音？')) return;
    await fetch(BASE + '/api/delete', { method:'POST', headers:{'content-type':'application/json'}, body: JSON.stringify({id:delId}) });
    if (playing === delId) { audio.pause(); stopPlay(); }
    refresh();
  }
});

document.getElementById('upload').addEventListener('click', async () => {
  const file = document.getElementById('voicefile').files[0];
  const stat = document.getElementById('uploadstat');
  if (!file) { stat.textContent = '请先选择录音文件'; return; }
  if (file.size > 16 * 1024 * 1024) { stat.textContent = '录音不能超过 16 MB'; return; }
  const sender = document.getElementById('sender').value;
  stat.textContent = '正在发送…';
  try {
    const res = await fetch(BASE + '/voice?from=' + encodeURIComponent(sender), {
      method:'POST', headers:{'content-type':file.type || 'application/octet-stream'}, body:file
    });
    if (!res.ok) throw new Error(await res.text());
    stat.textContent = '发送成功，板子会自动刷新';
    document.getElementById('voicefile').value = '';
    refresh();
  } catch (err) { stat.textContent = '发送失败：' + err.message; }
});

