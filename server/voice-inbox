    return;
  }
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia || !window.MediaRecorder) {
    recordStatus.textContent = '当前浏览器不支持录音，请用手机 Safari 或 Chrome 打开';
    return;
  }
  pressHeld = true;
  recordButton.setPointerCapture(e.pointerId);
  recordButton.classList.add('active');
  recordButton.textContent = '🔴';
  recordStatus.textContent = '请允许使用麦克风，并继续按住';
  try {
    mic = await navigator.mediaDevices.getUserMedia({ audio: true });
    if (!pressHeld) {
      mic.getTracks().forEach(t => t.stop()); mic = null;
      recordButton.classList.remove('active'); recordButton.textContent = '🎙️';
      recordStatus.textContent = '麦克风已就绪，请再按住说话';
      return;
    }
    chunks = [];
    recordSender = document.getElementById('sender').value;
    recorder = new MediaRecorder(mic);
    recorder.addEventListener('dataavailable', e => { if (e.data.size) chunks.push(e.data); });
    recorder.addEventListener('stop', async () => {
      clearInterval(recordClock);
      mic.getTracks().forEach(t => t.stop()); mic = null;
      recordButton.textContent = '🎙️'; recordButton.classList.remove('active');
      const clip = new Blob(chunks, { type: recorder.mimeType || 'audio/webm' });
      if (Date.now() - recordStarted < 400 || !clip.size) {
        recordStatus.textContent = '说话时间太短，请按住再试'; return;
      }
      sendingVoice = true; recordStatus.textContent = '正在发送给板子…';
      try {
        const res = await fetch(BASE + '/voice?from=' + encodeURIComponent(recordSender), {
          method:'POST', headers:{'content-type':clip.type || 'application/octet-stream'}, body:clip
        });
        if (!res.ok) throw new Error(await res.text());
        recordStatus.textContent = '已发送到板子'; refresh();
      } catch (err) { recordStatus.textContent = '发送失败：' + err.message; }
      sendingVoice = false;
    });
    recorder.start(); recordStarted = Date.now();
    recordButton.textContent = '🔴'; recordButton.classList.add('active');
    recordStatus.textContent = '正在说话 0 秒';
    recordClock = setInterval(() => {
      const sec = Math.floor((Date.now() - recordStarted) / 1000);
      recordStatus.textContent = '正在说话 ' + sec + ' 秒';
      if (sec >= 60 && recorder.state === 'recording') recorder.stop();
    }, 300);
  } catch (err) {
    if (mic) mic.getTracks().forEach(t => t.stop());
    mic = null; pressHeld = false;
    recordButton.classList.remove('active'); recordButton.textContent = '🎙️';
    recordStatus.textContent = '麦克风无法使用：' + err.message;
  }
});
function releaseVoice(e) {
  if (e) e.preventDefault();
  pressHeld = false;
  if (recorder && recorder.state === 'recording') recorder.stop();
}
recordButton.addEventListener('pointerup', releaseVoice);
recordButton.addEventListener('pointercancel', releaseVoice);

