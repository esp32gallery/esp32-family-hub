function log(...a) {
  console.log(`[${new Date().toISOString().slice(11, 19)}]`, ...a);
}

// ---------------------------------------------------------------- 联系人配置
function loadConf() {
  try {
    return JSON.parse(fs.readFileSync(CONF, "utf8"));
  } catch {
    return { contacts: {}, baseUrl: "" };
  }
}
function lanIp() {
  const all = [];
  for (const [name, list] of Object.entries(os.networkInterfaces())) {
    for (const i of list || []) {
      if (!i || i.family !== "IPv4" || i.internal) continue;
      all.push({ name, address: i.address });
    }
  }
  // 优先真实局域网（192.168/10./172.16-31），排除 Tailscale(100.64/10)、
  // Clash fake-ip(198.18/15) 这些隧道地址 —— 否则会给出手机上打不开的 IP
  const isTunnel = (a) =>
    a.startsWith("100.") || a.startsWith("198.18.") || a.startsWith("198.19.") || a.startsWith("169.254.");
  const lan = all.filter((x) => !isTunnel(x.address));
  const pick = lan.find((x) => x.name.startsWith("en")) || lan[0] || all[0];
  return pick ? pick.address : "127.0.0.1";
}
function baseUrl() {
  const c = loadConf();
  return FORCE_BASE || c.baseUrl || `http://${lanIp()}:${PORT}`;
}

// ---------------------------------------------------------------- 索引
function loadIndex() {
  try { return JSON.parse(fs.readFileSync(INDEX_PATH, "utf8")); } catch { return []; }
