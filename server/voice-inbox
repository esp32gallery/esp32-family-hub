const LOCAL_TLS_DIR = path.join(os.homedir(), ".config/voice-inbox/tls");
const LOCAL_HTTPS_PORT = Number(process.env.VOICE_LOCAL_HTTPS_PORT || 9443);
const TG_CHAT_ID = process.env.VOICE_TG_CHAT_ID || "795477335";
const TG_SEND_TOKEN_FILE = path.join(os.homedir(), ".config/voice-inbox/telegram-send-token");
const TG_SECRETS = path.join(os.homedir(), ".secrets.env");
// 网页和推送里用的地址；没配就自动取本机 IP
const FORCE_BASE = process.env.VOICE_INBOX_BASE || "";
const FFMPEG = ["/opt/homebrew/bin/ffmpeg", "/usr/local/bin/ffmpeg"].find((p) => fs.existsSync(p)) || "ffmpeg";

function telegramToken() {
  try {
    if (fs.existsSync(TG_SEND_TOKEN_FILE)) {
      const own = fs.readFileSync(TG_SEND_TOKEN_FILE, "utf8").trim();
      if (own) return own;
    }
    const m = fs.readFileSync(TG_SECRETS, "utf8").match(/^TG_BOT_TOKEN=(.+)$/m);
    return m ? m[1].trim() : "";
  } catch { return ""; }
}

async function telegramVoice(wavPath, caption) {
  const token = telegramToken();
  if (!token) { log("Telegram 发送跳过：没有 TG_BOT_TOKEN"); return false; }
  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "family-tg-"));
  const ogg = path.join(tmp, "voice.ogg");
  try {
    await execFileP(FFMPEG, ["-nostdin", "-hide_banner", "-loglevel", "error",
      "-i", wavPath, "-c:a", "libopus", "-b:a", "32k", "-ac", "1", "-ar", "48000",
      "-f", "ogg", ogg], { timeout: 30000 });
    const args = ["-sS", "--noproxy", "*", "-m", "60", "-X", "POST",
      `https://api.telegram.org/bot${token}/sendVoice`,
      "-F", `chat_id=${TG_CHAT_ID}`, "-F", `voice=@${ogg}`,
      "-F", `caption=${caption.slice(0, 1024)}`];
    try {
      await execFileP("curl", args, { encoding: "utf8", timeout: 65000 });
    } catch {
      const retry = args.filter(x => x !== "--noproxy" && x !== "*");
      retry.splice(1, 0, "-x", "socks5h://127.0.0.1:1082");
      await execFileP("curl", retry, { encoding: "utf8", timeout: 65000 });
    }
    log(`Telegram 已发送语音 ${path.basename(wavPath)} → ${TG_CHAT_ID}`);
    return true;
  } catch (e) {
    log(`Telegram 语音发送失败：${e.message}`);
    return false;
  } finally {
    fs.rmSync(tmp, { recursive: true, force: true });
  }
}

