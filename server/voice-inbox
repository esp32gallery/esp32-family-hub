  log(`  已有 ${loadIndex().length} 条`);
});

// Funnel 暴露的独立入口：分享链接换取仅限 /voice/ 的会话 Cookie。
// 内网服务及板子 API 不经过这里；公开入口只代理网页必需的路由。
http.createServer((req, res) => {
  const url = new URL(req.url, "http://x");
  let route = url.pathname.startsWith("/voice/") ? url.pathname.slice(6) : url.pathname;
  if (route === "/voice") route = "/voice";
  const key = url.searchParams.get("k") || "";
  const valid = (s) => s.length === PUBLIC_KEY.length &&
    crypto.timingSafeEqual(Buffer.from(s), Buffer.from(PUBLIC_KEY));
  if (key && valid(key) && req.method === "GET" && (route === "/" || route === "/index.html")) {
    res.writeHead(302, { "set-cookie": `voice_access=${PUBLIC_KEY}; Path=/voice/; Max-Age=2592000; Secure; HttpOnly; SameSite=Lax`, "location": "/voice/" });
    res.end(); return;
  }
  const cookie = (req.headers.cookie || "").split(";").map(s => s.trim()).find(s => s.startsWith("voice_access="));
  if (!cookie || !valid(cookie.slice(13))) {
    res.writeHead(401, { "content-type": "text/plain; charset=utf-8" });
    res.end("请使用家人分享的语音链接打开"); return;
  }
  const allowed = (req.method === "GET" && (route === "/" || route === "/index.html" || route === "/api/list" || route.startsWith("/audio/"))) ||
    (req.method === "POST" && (route === "/voice" || route === "/api/delete"));
  if (!allowed) { res.writeHead(404); res.end(); return; }
  const headers = { ...req.headers, host: `127.0.0.1:${PORT}` };
  delete headers.cookie;
  const proxy = http.request({ hostname: "127.0.0.1", port: PORT, method: req.method,
    path: route + url.search, headers }, upstream => {
    res.writeHead(upstream.statusCode || 502, upstream.headers);
    upstream.pipe(res);
  });
  proxy.on("error", () => { if (!res.headersSent) res.writeHead(502); res.end("服务暂不可用"); });
  req.pipe(proxy);
}).listen(PUBLIC_PORT, "127.0.0.1", () => log(`受保护的手机入口就绪：127.0.0.1:${PUBLIC_PORT}`));

// 内网直连：局域网 IP 不走 Tailscale。手机安装本站局域网根证书后，
// 可直接在这里录音、收听并发送，路径和 HTTP 页面完全一致。
try {
  const cert = fs.readFileSync(path.join(LOCAL_TLS_DIR, "server.crt"));
  const key = fs.readFileSync(path.join(LOCAL_TLS_DIR, "server.key"));
  https.createServer({ cert, key }, (req, res) => {
    const proxy = http.request({
      hostname: "127.0.0.1", port: PORT, method: req.method,
      path: req.url, headers: { ...req.headers, host: `127.0.0.1:${PORT}` }
    }, upstream => {
      res.writeHead(upstream.statusCode || 502, upstream.headers);
      upstream.pipe(res);
    });
    proxy.on("error", () => { if (!res.headersSent) res.writeHead(502); res.end("服务暂不可用"); });
    req.pipe(proxy);
  }).listen(LOCAL_HTTPS_PORT, "0.0.0.0", () =>
    log(`局域网 HTTPS：https://${lanIp()}:${LOCAL_HTTPS_PORT}/`));
} catch (e) {
  if (e.code !== "ENOENT") log(`局域网 HTTPS 未启动：${e.message}`);
}
