// ---------------------------------------------------------------- HTTP
const server = http.createServer(async (req, res) => {
  const url = new URL(req.url, "http://x");

  if (req.method === "GET" && (url.pathname === "/" || url.pathname === "/index.html")) {
    res.writeHead(200, { "content-type": "text/html; charset=utf-8" });
    res.end(PAGE.replace('__PUBLIC_URL__', PUBLIC_URL)); return;
  }
  if (req.method === "GET" && url.pathname === "/local-ca.p12") {
    const fp = path.join(LOCAL_TLS_DIR, "family-hub-local-ca.p12");
    if (!fs.existsSync(fp)) { res.writeHead(404); res.end("not found"); return; }
    res.writeHead(200, {
      "content-type": "application/x-pkcs12",
      "content-disposition": "attachment; filename=family-hub-local-ca.p12",
      "cache-control": "no-store",
    });
    fs.createReadStream(fp).pipe(res); return;
  }
  if (req.method === "GET" && url.pathname === "/manifest.webmanifest") {
    res.writeHead(200, { "content-type": "application/manifest+json" });
    res.end(JSON.stringify(MANIFEST)); return;
  }
  // ---- 部署辅助：让另一台 Mac 能直接拉源码和配置
  if (req.method === "GET" && url.pathname === "/deploy-air.sh") {
    const fp = path.join(os.homedir(), "bin/voice-inbox-deploy.sh");
    if (!fs.existsSync(fp)) { res.writeHead(404); res.end("no deploy script"); return; }
    res.writeHead(200, { "content-type": "text/x-shellscript; charset=utf-8" });
    res.end(fs.readFileSync(fp)); return;
  }
  if (req.method === "GET" && url.pathname === "/_src/voice-inbox") {
    res.writeHead(200, { "content-type": "text/plain; charset=utf-8" });
    res.end(fs.readFileSync(process.argv[1] || __filename)); return;
  }
  if (req.method === "GET" && url.pathname === "/_src/contacts.json") {
    res.writeHead(200, { "content-type": "application/json; charset=utf-8" });
    res.end(fs.readFileSync(CONF)); return;
  }

  if (req.method === "GET" && url.pathname === "/healthz") {
    const c = loadConf();
    res.writeHead(200, { "content-type": "application/json" });
    res.end(JSON.stringify({
      ok: true, count: loadIndex().length, dir: DIR,
      contacts: Object.fromEntries(Object.entries(c.contacts || {}).map(([k, v]) => [k, v.name])),
      baseUrl: baseUrl(),
    })); return;
  }

  // ---- 列表（带联系人名字，供网页做分栏）
  if (req.method === "GET" && url.pathname === "/api/list") {
    const c = loadConf();
    const names = {};
    for (const [k, v] of Object.entries(c.contacts || {})) names[k] = v.name || k;
    res.writeHead(200, { "content-type": "application/json" });
    const contact = url.searchParams.get("contact");
    const direction = url.searchParams.get("direction");
    const limit = Math.max(1, Math.min(100, Number(url.searchParams.get("limit")) || 100));
    res.end(JSON.stringify({
      ok: true,
      contacts: names,
      items: loadIndex().filter((it) => (!contact || it.contact === contact) && (!direction || it.direction === direction))
        .sort((a, b) => b.ts - a.ts).slice(0, limit),
    })); return;
  }

  // ---- 播放（支持 Range，可拖动）
  if (req.method === "GET" && url.pathname.startsWith("/audio/")) {
    const id = path.basename(url.pathname.slice(7));
    const fp = path.join(DIR, id + ".wav");
    if (!fp.startsWith(DIR) || !fs.existsSync(fp)) { res.writeHead(404); res.end("not found"); return; }
    const st = fs.statSync(fp);
    const range = req.headers.range;
    if (range) {
      const m = /bytes=(\d*)-(\d*)/.exec(range);
      const start = m[1] ? parseInt(m[1]) : 0;
      const end = m[2] ? parseInt(m[2]) : st.size - 1;
      res.writeHead(206, {
      "content-type": "audio/wav", "accept-ranges": "bytes",
      "cache-control": "public, max-age=31536000, immutable",
        "content-range": `bytes ${start}-${end}/${st.size}`,
        "content-length": end - start + 1,
      });
      fs.createReadStream(fp, { start, end }).pipe(res);
    } else {
      res.writeHead(200, { "content-type": "audio/wav", "accept-ranges": "bytes",
        "content-length": st.size, "cache-control": "public, max-age=31536000, immutable" });
      fs.createReadStream(fp).pipe(res);
    }
    return;
  }

  // ---- 删除
  if (req.method === "POST" && url.pathname === "/api/delete") {
    let body = "";
    req.on("data", (c) => (body += c));
    req.on("end", () => {
      try {
        const { id } = JSON.parse(body || "{}");
        saveIndex(loadIndex().filter((x) => x.id !== id));
        const fp = path.join(DIR, path.basename(id) + ".wav");
        if (fp.startsWith(DIR) && fs.existsSync(fp)) fs.unlinkSync(fp);
        log(`删除 ${id}`);
        res.writeHead(200, { "content-type": "application/json" });
        res.end(JSON.stringify({ ok: true }));
      } catch (e) { res.writeHead(400); res.end(String(e.message)); }
    });
    return;
  }

  // ---- 板子上传
  if (req.method === "POST" && url.pathname === "/voice") {
    if (SECRET) {
      const got = req.headers["x-voice-secret"] || url.searchParams.get("k");
      if (got !== SECRET) { res.writeHead(401); res.end("bad secret"); return; }
    }
    // 联系人从 query 或 header 来；板子最省事的做法是 query
    const incoming = url.searchParams.has("from");
    const contact = (url.searchParams.get(incoming ? "from" : "to") || req.headers["x-contact"] || "me").toString();
    if (!/^(dad|mom|me)$/.test(contact)) { res.writeHead(400); res.end("unknown contact"); return; }

    const chunks = [];
    let total = 0, aborted = false;
    req.on("data", (c) => {
      total += c.length;
      if (total > MAX_BYTES) {
        aborted = true; res.writeHead(413); res.end("too large"); req.destroy(); return;
      }
      chunks.push(c);
    });
    req.on("end", async () => {
      if (aborted) return;
      let body = Buffer.concat(chunks);
      if (incoming) {
        const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "voice-inbox-"));
        try {
          const input = path.join(tmp, "input");
          const output = path.join(tmp, "output.wav");
          fs.writeFileSync(input, body);
          await execFileP(FFMPEG, ["-nostdin", "-hide_banner", "-loglevel", "error", "-i", input,
            "-af", "highpass=f=150,equalizer=f=3200:t=q:w=1:g=2", "-ac", "1", "-ar", "32000",
            "-c:a", "pcm_s16le", "-f", "wav", output],
            { timeout: 30000 });
          body = canonicalWav(fs.readFileSync(output));
        } catch (e) {
          res.writeHead(400); res.end("audio conversion failed"); return;
        } finally { fs.rmSync(tmp, { recursive: true, force: true }); }
      }
      const info = parseWav(body);
      if (!info.ok) {
        log(`拒收 WAV：${info.reason}（${body.length}B）`);
        res.writeHead(400); res.end(`bad wav: ${info.reason}`); return;
      }

      const ts = Date.now();
      const id = `voice-${new Date(ts).toISOString().replace(/[:.]/g, "-")}`;
      fs.writeFileSync(path.join(DIR, id + ".wav"), body);

      const list = loadIndex();
      list.push({
        id, ts, contact, direction: incoming ? "in" : "out",
        seconds: Number(info.seconds.toFixed(2)),
        sampleRate: info.sampleRate, channels: info.channels, bits: info.bits,
        bytes: body.length,
      });
      saveIndex(list);

      log(`收到 ${info.seconds.toFixed(1)}s → ${contact} · ${info.sampleRate}Hz/${info.channels}ch · ${Math.round(body.length/1024)}KB`);

      // 推送失败不影响「已保存」
      const pr = incoming ? { ok: false } : await pushNotify(contact, info, id);
      const tgsent = await telegramVoice(path.join(DIR, id + ".wav"),
        `宝宝发给${loadConf().contacts?.[contact]?.name || contact} · ${info.seconds.toFixed(1)} 秒`);

      res.writeHead(200, { "content-type": "application/json" });
      res.end(JSON.stringify({ ok: true, id, seconds: info.seconds, pushed: pr.ok, tg: tgsent }));
    });
    return;
  }

  res.writeHead(404, { "content-type": "text/plain" });
  res.end("404\n");
});

server.listen(PORT, HOST, () => {
